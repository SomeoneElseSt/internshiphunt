# Google Gemini API Key
# Required for AI-powered resume analysis, question generation, and document creation
# Get API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# AgentQL API Key
# Required for analyzing application links and extracting document requirements
# Get API key from: https://www.agentql.com/
AGENT_QL_API_KEY=your_agentql_api_key_here

# GitHub API Token (Optional)
# Improves rate limits when fetching internship data from GitHub repositories
# Without this, unauthenticated access will be used (lower rate limits)
# Get token from: https://github.com/settings/tokens
GITHUB_KEY=your_github_token_here

